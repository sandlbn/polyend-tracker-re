{
  "name": "opentracker-theme-editor",
  "private": true,
  "type": "module",
  "scripts": {
    "generate": "node scripts/generate-theme-data.mjs",
    "test": "node scripts/generate-theme-data.mjs && vitest run",
    "dev": "node scripts/generate-theme-data.mjs && vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "node scripts/generate-theme-data.mjs && tsc --noEmit && vite build"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "typescript": "5.5.4",
    "vite": "5.4.11",
    "vitest": "1.6.1"
  }
}
